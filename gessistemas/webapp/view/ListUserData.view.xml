<mvc:View
    controllerName="com.becloud.pdp.gessistemas.controller.ListUserData"
    xmlns:mvc="sap.ui.core.mvc" displayBlock="true"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:f="sap.f">

    <!-- Dynamic Page -->
    <f:DynamicPage id="dynamicPage" title="Conexiones" headerExpanded="{/headerExpanded}">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Conexiones: Tech Solutions Usuarios." />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Dynamic Page Header -->
        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <!-- Filter Bar Section -->
                    <fb:FilterBar
                               class="sapUiSizeCompact"
                        reset="onResetFilters"
                        showRestoreOnFB="true"
                        showGoOnFB="true"
                        showFilterConfiguration="false"
                        useToolbar="false"
                    >
                        <fb:filterItems>
                            <fb:FilterItem name="A" label="Nombre ">
                                <fb:control>
                                    <Input id="NameSearch" width="100%" liveChange="changeFilter" placeholder="Nombre de la conexión"/>
                                </fb:control>
                            </fb:FilterItem>
                            <fb:FilterItem name="B" label="Estado">
                                <fb:control>
                                    <Select id="slEstadoSearch" selectedKey="0" change="changeFilter">
                                        <core:Item key="0" text="Todos" />
                                        <core:Item key="1" text="Activo" />
                                        <core:Item key="2" text="Inactivo" />
                                    </Select>
                                </fb:control>
                            </fb:FilterItem>
                            <fb:FilterItem name="C" label="Rango de Fechas">
                                <fb:control>
                                    <DateRangeSelection
                                        id="ipFechaCreacionConexion"
                                        displayFormat="yyyy/MM/dd"
                                        change="onDateRangeChange"
                                        placeholder="Filtra por rango de fecha"
                                    />
                                </fb:control>
                            </fb:FilterItem>

                            <fb:FilterItem
                                name="M"
                                label="Fecha de Modificación"
                            >
                                <fb:control>
                                    <DateRangeSelection
                                        id="ipFechaModifConexion"
                                        displayFormat="dd/MM/yyyy"
                                        change="onDateRangeChange"
                                  
                            
                                        placeholder="Filtra por rango de fecha"
                                    />
                                </fb:control>
                            </fb:FilterItem>
                        </fb:filterItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <!-- Dynamic Page Content -->
        <f:content>
            <Text text="{localModel>systemName}" />

            <VBox class="sapUiSmallMargin">
                <Table
                    id="idListUsersTable"
                    sticky="ColumnHeaders,HeaderToolbar"
                    items="{path: 'oModelUsersData>/', sorter: [{path: 'id', descending: false}]}"
                    mode="None"
                    updateFinished="updateFinished"
                    growing="true"
                    growingThreshold="10"
                    visible="{= ${/isSecondTableVisible} === false }"
                >
                    <headerToolbar>
                        <Toolbar>
                            <content>
                                <Title id="idListUsersData" text="Registros (0)" />
                                <Button icon="sap-icon://excel-attachment" press="onExcel" tooltip="Descargar registros" />
                                <ToolbarSpacer />
                               
                                <Button
                                    class="sapUiSizeCompact"
                                    tooltip="Ingresar Conexion"
                                    iconFirst="false"
                                    text="Ingresar Conexion"
                                    icon="sap-icon://create-form"
                                    type="Emphasized"
                                    press="onCreateConexion"
                                />
                                 <Button
                                    class="sapUiSizeCompact"
                                    tooltip="Actualizar datos"
                                    iconFirst="false"
                        
                                    icon="sap-icon://synchronize"
                                    type="Emphasized"
                                    press="onRefresh"
                                />
                            </content>
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Conexión" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Tipo" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Método" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Path" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Host" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Estado" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true">
                            <Text text="Fecha Creación" />
                        </Column>
                          <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Fecha de Modificación" />
                        </Column>
                        <Column minScreenWidth="Tablet" demandPopin="true" hAlign="Center" vAlign="Middle">
                            <Text text="Acciones" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem>
                            <cells>
                                <ObjectIdentifier text="{oModelUsersData>API_name}" />
                                <ObjectIdentifier text="{oModelUsersData>Tipo_conexion}" />
                                <ObjectIdentifier text="{oModelUsersData>Metodo}" />
                                <ObjectIdentifier text="{oModelUsersData>Path}" />
                                <ObjectIdentifier text="{oModelUsersData>Host}" />
                                <ObjectStatus
                                    text="{path: 'oModelUsersData>status', formatter: '.formatterEstado'}"
                                    state="{path: 'oModelUsersData>status', formatter: '.formatterState'}"
                                    inverted="true"
                                />
                                <ObjectIdentifier text="{path: 'oModelUsersData>creationDate', formatter: '.formatDate'}" />
                                 <ObjectIdentifier text="{path: 'oModelUsersData>updateDate', formatter: '.formatDate'}" />
                                <HBox justifyContent="SpaceAround">
                                    <Button icon="sap-icon://detail-view" press="onDetailAPI" tooltip="Detalles" type="Transparent" />
                                    <Button icon="sap-icon://edit" press="onEditAPI" tooltip="Editar" type="Transparent" />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
