<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
>
    <Dialog
        title="Nuevo Sistema"
        type='Message'
        contentWidth="600px"
        contentHeight="500px"
        class="sapUiNoContentPadding"
    >
        <content>
            <l:Grid
                vSpacing="1.5"
                hSpacing="1"
                width="100%"
                class="sapUiSmallMargin"
            >
                <VBox>
                    <Title text="Información del Sistema" />
                    <Label text="Nombre del Sistema*" />
                    <Input
                        id="ipNameCreate"
                        width="100%"
                        liveChange="liveChange"
                    />
                    <Label text="Descripción" />
                    <TextArea
                        id="ipDescriptionCreate"
                        rows="2"
                        width="100%"
                        liveChange="liveChange"
                    />

                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12" />
                    </layoutData>
                </VBox>

                <VBox>
                    

                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12" />
                    </layoutData>
                </VBox>

                <VBox>
                    <Button
                        type="Emphasized"
                        text="Agregar API"
                        press="onAgregarPress"
                    />

 
                </VBox>

     
            </l:Grid>
        </content>
        <beginButton>
            <Button
                text="Guardar"
                type="Emphasized"
                press="onSaveCreate"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancelar"
                press="onCloseCreate"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
