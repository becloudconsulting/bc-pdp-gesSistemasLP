<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog title="Ingresar datos del sistema" type='Message' contentWidth="600px" class="sapUiNoContentPadding">
        <content>
            <l:Grid vSpacing="1" hSpacing="1" width="100%" class="sapUiSmallMargin">
                <VBox>
                    <Title text="Información del Sistema"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Nombre del Sistema" />
                    <Input id="ipNameCreate" width="100%" liveChange="liveChange"/>
                    <Label text="Método" />
                    <Select id="slMethodCreate" forceSelection="true" width="100%">
                        <core:Item key="" text=""/>
                        <core:Item key="GET" text="GET"/>
                        <core:Item key="POST" text="POST"/>
                        <core:Item key="PUT" text="PUT"/>
                        <core:Item key="DELETE" text="DELETE"/>
                    </Select>
                    <Label text="EndPoint" />
                    <Input id="ipEndPointCreate" width="100%" liveChange="liveChange"/>
                    <Label text="Tipo de Conexión" />
                    <Select id="ipTypeConnectionCreate" forceSelection="true" width="100%">
                        <core:Item key="" text=""/>
                        <core:Item key="API" text="API"/>
                        <core:Item key="ODATA" text="ODATA"/>
                    </Select>
                    <Label text="Estado" />
                    <Select id="slStatusCreate" forceSelection="true" width="100%">
                        <core:Item key="" text=""/>
                        <core:Item key="Activo" text="Activo"/>
                        <core:Item key="Inactivo" text="Inactivo"/>
                    </Select>
                    <Label text="Token" />
                    <Input id="ipTokenCreate" width="100%" liveChange="liveChange"/>
                    <Label text="Descripción" />
                    <TextArea id="ipDescriptionCreate" rows="4" width="100%" liveChange="liveChange"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
            </l:Grid >
        </content>
        <beginButton>
            <Button text="Guardar" type="Emphasized" press="onSaveCreate"/>
        </beginButton>
        <endButton>
            <Button text="Cancelar" press="onCloseCreate"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
