<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog id="dlgInfoUser" title="Información del Usuario" type='Message' contentWidth="600px" class="sapUiNoContentPadding">
        <content>
            <l:Grid vSpacing="1" hSpacing="1" width="100%" class="sapUiSmallMargin">
                <VBox>
                    <Title text="Información del Usuario"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Nombres"/>
                    <Input enabled="false" width="100%" value="{oModelUsersData>firstName}"/>
                    
                    <Label text="Apellidos"/>
                    <Input enabled="false" width="100%" value="{oModelUsersData>lastName}"/>
                    
                    <Label text="Correo"/>
                    <Input enabled="false" width="100%" value="{oModelUsersData>email}"/>
                    
                    <Label text="RUT"/>
                    <Input enabled="false" width="100%" value="{oModelUsersData>rut}"/>
                    
                    <Label text="Estado"/>
                    <Input enabled="false" width="100%" value="{path: 'oModelUsersData>status', formatter: '.formatterEstado'}" />
                    
                    <Label text="Fecha de Creación"/>
                    <Input enabled="false" width="100%" value="{path: 'oModelUsersData>creationDate', formatter: '.formatDate'}"/>
                    
                    <Label text="Teléfono"/>
                    <Input enabled="false" width="100%" value="{oModelUsersData>phone}"/>

                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
            </l:Grid>
        </content>
        <beginButton>
            <Button text="Cerrar" press=".onCloseInfoUser"/>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
