<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog title="Credenciales" type='Message' contentWidth="600px" class="sapUiNoContentPadding">
        <content>
            <l:Grid vSpacing="1" hSpacing="1" width="100%" class="sapUiSmallMargin">

                <VBox>
                    <Label text="Tipo de autenticación" />
                    <Input enabled="false" id="ipTipoAuth" width="100%" liveChange="liveChange" value="{oModelCredencialesFF>Tipo_autent}"/>
                    <Label  text="URI" />
                    <Input enabled="false" id="ipURI" width="100%" liveChange="liveChange"/>
                    <Label text="Usuario" />
                    <Input enabled="false" id="ipUsuario" width="100%" liveChange="liveChange"/>
                    <Label text="Contraseña" />
                    <Input enabled="false" id="ipPSW" width="100%" liveChange="liveChange"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
            </l:Grid >
        </content>
        <beginButton>
            <Button text="Guardar" type="Emphasized" press="onSaveCreate"/>
        </beginButton>
        <endButton>
            <Button text="Cancelar" press="onCloseCreate"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
