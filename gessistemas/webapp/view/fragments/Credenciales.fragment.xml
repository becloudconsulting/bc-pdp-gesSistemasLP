<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog title="Credenciales" type='Message' contentWidth="600px" class="sapUiNoContentPadding">
        <content>
            <l:Grid vSpacing="1" hSpacing="1" width="100%" class="sapUiSmallMargin">

                <VBox>
<!--Está asociado con el modelo oModelCredencialesFF del controller, por alguna razón no trae esos datos, por eso están en duro-->
                    <Label text="Tipo de autenticación" />
                    <Input enabled="false" id="ipTipoAuth" width="100%" liveChange="liveChange" value="Autenticación Básica"/>
                    <Label  text="URI" />
                    <Input enabled="false" id="ipURI1" width="100%" liveChange="liveChange"  value="https://api.ejemplo.com/authentication/a"/>
                    <Label text="Usuario" />
                    <Input enabled="false" id="ipUsuario1" width="100%" liveChange="liveChange"  value="Admin"/>
                    <Label text="Contraseña" />
                    <Input enabled="false" id="ipPSW1" width="100%" liveChange="liveChange" value="*******"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
            </l:Grid >
        </content>
        <beginButton>
            <Button text="Guardar" type="Emphasized" press="onSaveCreate" visible="false"/>
        </beginButton>
        <endButton>
            <Button text="Cerrar" press="CerrarCredenciales"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>

