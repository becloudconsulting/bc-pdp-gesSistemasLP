<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog title="Nueva conexión" type='Message' contentWidth="600px" class="sapUiNoContentPadding">
        <content>
            <l:Grid vSpacing="1" hSpacing="1" width="100%" class="sapUiSmallMargin">
                <VBox>
                    <Title text="Información de conexión"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Nombre conexión" />
                    <Input id="name_conexionEdit" width="100%" liveChange="liveChange" />
                      <Label text="Descripción" />
                    <TextArea id="name_descripEdit" rows="4" width="100%" liveChange="liveChange"/>
                    <Label text="Método" />
                    <Select id="name_metodoEdit" forceSelection="true" width="100%">
                        <core:Item key="" text=""/>
                        <core:Item key="GET" text="GET"/>
                        <core:Item key="POST" text="POST"/>
                        <core:Item key="PUT" text="PUT"/>
                        <core:Item key="DELETE" text="DELETE"/>
                    </Select>
                    <Label text="Path/Endpoint" />
                    <Input id="name_pathEdit" width="100%" liveChange="liveChange"/>
                    <Label text="Tipo de Conexión" />
                    <Select id="name_tipoEdit" forceSelection="true" width="100%">
                        <core:Item key="" text=""/>
                        <core:Item key="API" text="API"/>
                        <core:Item key="ODATA" text="ODATA"/>
                    </Select>
                    <Label text="Host" />
                    <Input id="name_hostEdit" width="100%" liveChange="liveChange"/>
                    <Label text="Estado" />
                    <Select id="name_estadoEdit" forceSelection="true" width="100%" >
                        <core:Item key="" text=""/>
                        <core:Item key="Activo" text="Activo"/>
                        <core:Item key="Inactivo" text="Inactivo"/>
                    </Select>
                                 
                    <HBox class ='políticasLabel'>
                        <Button text="Probar conexión" press="" class='myTextWithMarginRight'/>
                        <Button text="Editar parámetros de entrada" press="onCreateParam" />
                    </HBox>

                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
            </l:Grid >
        </content>
        <beginButton>
            <Button text="Guardar" type="Emphasized" press="onSaveCreate"/>
        </beginButton>
        <endButton>
            <Button text="Cancelar" press="onCloseCreate"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>
