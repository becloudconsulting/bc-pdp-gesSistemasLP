<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog id="dlgInfoCompanySystem" title="Sistema seleccionado: " type='Message' contentWidth="600px" class="sapUiNoContentPadding">
        <content>
            <l:Grid vSpacing="1" hSpacing="1" width="100%" class="sapUiSmallMargin">
                <VBox>
                    <Title text="Información del Sistema"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Motivo"/>
                    <Input enabled="false" width="100%" value="{oModelCompanySystem>companySystemName}"/>
                    <Label text="Sistema asociado a la denuncia" />
                    <Input enabled="false" width="100%" value="{oModelCompanySystem>method}"/>
                    <Label text="API asociada a la denuncia" />
                    <Input enabled="false" width="100%" value="{oModelCompanySystem>endPoint}"/>
                    <Label text="Tipo Conexión" />
                    <Input enabled="false" width="100%" value="{oModelCompanySystem>connectionType}"/>
                    <Label text="Estado"/>
                    <Input enabled="false" width="100%" value="{path: 'oModelCompanySystem>status', formatter: '.formatterEstado'}" state="{path: 'oModelCompanySystem>status', formatter: '.formatterState'}" inverted="true"/>
                    <Label text="Descripción" />
                    <TextArea enabled="false" rows="4" value="{oModelCompanySystem>description}" width="100%"/>
                    <Label text="Token" />
                    <TextArea enabled="false" rows="4" value="{oModelCompanySystem>token}" width="100%"/>

                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
            </l:Grid>
        </content>
        <beginButton>
            <Button text="Cerrar" press="onCloseInfoSystemCompany"/>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
