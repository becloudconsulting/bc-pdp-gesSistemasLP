<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout">
    <Dialog id="dlgInfoCompanySystem" title="Sistema seleccionado: " type='Message' contentWidth="600px" class="sapUiNoContentPadding">
        <content>
            <l:Grid vSpacing="1" hSpacing="1" width="100%" class="sapUiSmallMargin">
                <VBox>
                    <Title text="Información del Sistema"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Nombre sistema"/>
                    <Input enabled="false" width="100%" value="{oModelCompanySystem>companySystemName}"/>
                    <Label text="Descripción" />
                    <Input enabled="false" width="100%" value="{oModelCompanySystem>Descripcion}"/>
                    <Label text="Cantidad de servicios" />
                    <Input enabled="false" width="100%" value="{oModelCompanySystem>Servicios}"/>
                    <Label text="Creado por:" />
                    <Input enabled="false" width="100%" value="{oModelCompanySystem>Creador}"/>


                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
            </l:Grid>
        </content>
        <beginButton>
            <Button text="Cerrar" press="onCloseInfoSystemCompany"/>
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
