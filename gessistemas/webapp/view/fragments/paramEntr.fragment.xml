<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:fo="sap.ui.layout.form"
    xmlns:k="sap.m"
    xmlns:dnd="sap.ui.core.dnd"
    xmlns:u="sap.ui.unified"
>
    <k:Page
        showHeader="false"
        enableScrolling="false"
    >
        <k:content>
            <TreeTable
                id="TreeTable"
                rows="{path:'/catalog/clothing', parameters: {arrayNames:['categories']}}"
                selectionMode="MultiToggle"
                enableSelectAll="false"
                ariaLabelledBy="title"
            >
                <extension>
                    <k:OverflowToolbar style="Clear">
                        <k:Title
                            id="title"
                            text="Clothing"
                        />
                        <k:Button
                            id="cut"
                            text="Cut"
                            icon="sap-icon://scissors"
                            press="onCut"
                        />
                        <k:Button
                            id="paste"
                            text="Paste"
                            icon="sap-icon://paste"
                            press="onPaste"
                            enabled="false"
                        />
                        <k:ToolbarSpacer />
                        <k:Button
                            text="Collapse all"
                            press="onCollapseAll"
                        />
                        <k:Button
                            text="Expand first level"
                            press="onExpandFirstLevel"
                        />
                    </k:OverflowToolbar>
                </extension>
                <dragDropConfig>
                    <dnd:DragDropInfo
                        sourceAggregation="rows"
                        targetAggregation="rows"
                        dragStart="onDragStart"
                        drop="onDrop"
                    />
                </dragDropConfig>
                <columns>
                    <Column width="13rem">
                        <k:Label text="Categories" />
                        <template>
                            <k:Text
                                text="{name}"
                                wrapping="false"
                            />
                        </template>
                    </Column>
                    <Column width="9rem">
                        <k:Label text="Price" />
                        <template>
                            <u:Currency
                                value="{amount}"
                                currency="{currency}"
                            />
                        </template>
                    </Column>
                    <Column>
                        <k:Label text="Size" />
                        <template>
                            <k:Select
                                items="{path: '/sizes', templateShareable: true}"
                                selectedKey="{size}"
                                visible="{= !!${size}}"
                                forceSelection="false"
                            >
                                <core:Item
                                    key="{key}"
                                    text="{value}"
                                />
                            </k:Select>
                        </template>
                    </Column>
                </columns>
            </TreeTable>
        </k:content>
    </k:Page>

