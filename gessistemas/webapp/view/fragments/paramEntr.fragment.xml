 <core:FragmentDefinition
    xmlns="sap.m"
    xmlns:table="sap.ui.table"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:fo="sap.ui.layout.form"
    xmlns:k="sap.m"
    xmlns:dnd="sap.ui.core.dnd"
    xmlns:u="sap.ui.unified"
    controllerName="com.becloud.pdp.gessistemas.controller.fragments_controller.paramEntr"
>
    <Dialog
        title="Parámetros de entrada y salida"
        type='Message'
        contentWidth="1200px"
        horizontalScrolling="false"
        class="sapUiNoContentPadding"
    >
        <content>
            <VBox>
                <Panel
                    width="100%"
                    height="auto"
                >
                    <table:TreeTable
    id="TreeTable"
    rows="{path: 'oModelCatalog>/catalog/inputs'}"
    selectionBehavior="RowOnly"
    enableSelectAll="false"
    ariaLabelledBy="title"
>
    <table:extension>
        <k:OverflowToolbar style="Clear" >
            <k:Title
                id="title"
                text="Inputs de entrada"
                textAlign="Begin"
            />
            <k:Button
                text="Agregar Nivel Principal"
                icon="sap-icon://add"
                press="onAddMainLevel" 
                class="MarginLeftAgregarNivelPrincipal"
            />
        </k:OverflowToolbar>
    </table:extension>

    <table:columns>
        <!-- Columna Nombre -->
        <table:Column width="13rem">
            <k:Label text="Nombre" />
            <table:template>
                <Input value="{oModelCatalog>name}" />
            </table:template>
        </table:Column>

        <!-- Columna Tipo (Select) -->
        <table:Column width="9rem">
            <k:Label text="Tipo" />
            <table:template>
                <k:Select
                    items="{path: 'oModelCatalog>/types', templateShareable: true}"
                    selectedKey="{oModelCatalog>type}"
                    forceSelection="false"
                    change="onSelectTypeChange" 
                >
                    <core:Item key="{oModelCatalog>key}" text="{oModelCatalog>value}" />
                </k:Select>
            </table:template>
        </table:Column>

        <!-- Columna Descripción -->
        <table:Column>
            <k:Label text="Descripción" />
            <table:template>
                <Input
                    value="{oModelCatalog>description}"
                    width="100%"
                />
            </table:template>
        </table:Column>

        <!-- Columna Acción (Agregar subnivel y Eliminar) -->
        <table:Column>
            <k:Label text="Acción" />
            <table:template>
                <HBox>
                    <!-- Botón Agregar Subnivel, solo visible si el tipo es JSON -->
                    <Button
                        icon="sap-icon://add"
                        text="Agregar Subnivel"
                        press="onAddSublevel"
                        type="Transparent"
                        visible="{= ${oModelCatalog>type} === 'JSON' }" 
                    />
                    <Button
                        icon="sap-icon://delete"
                        press="onDeleteSublevel"
                        type="Transparent"
                    />
                </HBox>
            </table:template>
        </table:Column>
    </table:columns>
</table:TreeTable>


<table:TreeTable
    id="TreeTableOutput"
    rows="{path: 'oModelCatalogOutput>/catalog/outputs'}"
    selectionBehavior="RowOnly"
    enableSelectAll="false"
    ariaLabelledBy="titleOutput"
>
    <table:extension>
        <k:OverflowToolbar style="Clear" >
            <k:Title
                id="titleOutput"
                text="Inputs de salida"
                textAlign="Begin"
            />
            <k:Button
                text="Agregar Nivel Principal"
                icon="sap-icon://add"
                press="onAddMainLevelOutput" 
                class="MarginLeftAgregarNivelPrincipal"
            />
        </k:OverflowToolbar>
    </table:extension>

    <table:columns>
        <!-- Columna Nombre -->
        <table:Column width="13rem">
            <k:Label text="Nombre" />
            <table:template>
                <Input value="{oModelCatalogOutput>name}" />
            </table:template>
        </table:Column>

        <!-- Columna Tipo (Select) -->
        <table:Column width="9rem">
            <k:Label text="Tipo" />
            <table:template>
                <k:Select
                    items="{path: 'oModelCatalogOutput>/types', templateShareable: true}"
                    selectedKey="{oModelCatalogOutput>type}"
                    forceSelection="false"
                    change="onSelectTypeChangeOutput" 
                >
                    <core:Item key="{oModelCatalogOutput>key}" text="{oModelCatalogOutput>value}" />
                </k:Select>
            </table:template>
        </table:Column>

        <!-- Columna Descripción -->
        <table:Column>
            <k:Label text="Descripción" />
            <table:template>
                <Input
                    value="{oModelCatalogOutput>description}"
                    width="100%"
                />
            </table:template>
        </table:Column>

        <!-- Columna Acción (Agregar subnivel y Eliminar) -->
        <table:Column>
            <k:Label text="Acción" />
            <table:template>
                <HBox>
                    <!-- Botón Agregar Subnivel, solo visible si el tipo es JSON -->
                    <Button
                        icon="sap-icon://add"
                        text="Agregar Subnivel"
                        press="onAddSublevelOutput"
                        type="Transparent"
                        visible="{= ${oModelCatalogOutput>type} === 'JSON' }" 
                    />
                    <Button
                        icon="sap-icon://delete"
                        press="onDeleteSublevelOutput"
                        type="Transparent"
                    />
                </HBox>
            </table:template>
        </table:Column>
    </table:columns>
</table:TreeTable>

                   

                </Panel>
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Guardar"
                type="Emphasized"
                press="onGuardarParametro"
            />
        </beginButton>
        <endButton>
            <Button
                text="Cancelar"
                press="onCloseParam"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition> 


