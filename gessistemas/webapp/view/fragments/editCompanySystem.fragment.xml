<core:FragmentDefinition xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:l="sap.ui.layout"
    xmlns:u="sap.ui.unified"> 

    <Dialog id="dlgEditCompanySystem" title="Editar Sistema" type='Message' contentWidth="600px" class="sapUiNoContentPadding">
        <content>
            <l:Grid vSpacing="1" hSpacing="1" width="100%" class="sapUiSmallMargin">
                <VBox>
                    <Title text="Editar Información del Sistema"/>
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>
                </VBox>
                <VBox>
                    <Label text="Nombre del Sistema" />
                    <Input editable="true" id="ipNameEdit" width="100%" value="{oModelCompanySystem>companySystemName}" />
                    
                    <Label text="Descripción" />
                    <Input editable="true" id="ipDescipcion" width="100%" value="{oModelCompanySystem>Descripcion}" />
                    
                        
                    <Label text="Estado" />
                    <Select id="slStatusEdit" forceSelection="true" width="100%" selectedKey="{path: 'oModelCompanySystem>status', formatter: '.formatterEstado'}" state="{path: 'oModelCompanySystem>status', formatter: '.formatterState'}" inverted="true">
                        <core:Item key="1" text="Activo"/>
                        <core:Item key="2" text="Inactivo"/>
                    </Select>
                    
                    <layoutData>
                        <l:GridData span="XL12 L12 M12 S12"/>
                    </layoutData>

                    <Label text="RAT" labelFor="comboSistemaEdit"/>
                    <ComboBox 
                        id="comboSistemaEdit" 
                        selectedKey=""
                        width="100%"
                        selectionChange=".onsistemaCompanySystem">
                        <items>
                            <core:Item key="Interno" text="Interno"/>
                            <core:Item key="Externo" text="Externo"/>
                        </items>
                    </ComboBox>

                    
                    <Label text="Adjunto de Encargado" />
                    <u:FileUploader
                        id="fileUploaderEdit"
                        width="100%"
                        name="myFileUpload"
                        uploadUrl="upload/"
                        tooltip="Sube tu archivo al servidor"
                        uploadComplete=".UploadEditCompleto"
                        visible="true"
                        style="Emphasized"
                        buttonText="Subir archivo"
                        fileType="pdf,jpg,png"
                        maximumFileSize="10"
                        sendXHR="true"/>
                </VBox>
            </l:Grid>
        </content>
        <beginButton>
            <Button text="Guardar" press="onGuardarEditSistema" type="Emphasized"/>
        </beginButton>
        <endButton>
            <Button text="Cancelar" press=".onCloseEdit"/>
        </endButton>
    </Dialog>
</core:FragmentDefinition>