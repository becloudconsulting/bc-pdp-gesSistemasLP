<mvc:View
    height="100%"
    controllerName="com.becloud.pdp.gessistemas.controller.NewSystem"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <NavContainer id="wizardNavContainer">
        <pages>
            <Page
                id="wizardContentPage"
                showHeader="false"
            >
                <content>
                    <Wizard
                        id="CreateProductWizard"
                        class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
                        complete="wizardCompletedHandler"
                    >
                        <WizardStep
                            id="ProductTypeStep"
                            title="Crear sistema: Información del sistema"
                            validated="false"
                        >
                            <MessageStrip
                                class="sapUiSmallMarginBottom"
                                text="Ingrese los datos del sistema"
                                showIcon="true"
                            />

                            <form:SimpleForm
                                editable="true"
                                layout="ResponsiveGridLayout"
                            >
                                <Label text="Nombre del Sistema*" />
                                <Input
                                    id="ipNameCreate"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                                <Label text="Descripción" />
                                <TextArea
                                    id="ipDescriptionCreate"
                                    rows="2"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                            </form:SimpleForm>
                                <HBox justifyContent="End"  >
                               <Button visible="false" class="sapUiSizeCompact" tooltip="Continuar"  text="Continuar"  type="Emphasized" press="onNextStep"/>
                                
                            </HBox>
             
                        </WizardStep>
                        <WizardStep
                            id="CredencialesWizard"
                            validated="false"
                            title="Crear sistema: Credenciales"
                        >
                            <MessageStrip
                                class="sapUiSmallMarginBottom"
                                text="Ingrese las credenciales del sistema"
                                showIcon="true"
                            />
                            <form:SimpleForm
                                editable="true"
                                layout="ResponsiveGridLayout"
                            >
                                <Label text="Tipo de autenticación*" />
                                <Select
                                    id="ipTypeAuth"
                                    forceSelection="true"
                                    width="100%"
                                >
                                    <core:Item
                                        key=""
                                        text=""
                                    />
                                    <core:Item
                                        key="API"
                                        text="A"
                                    />
                                    <core:Item
                                        key="ODATA"
                                        text="B"
                                    />
                                    <core:Item
                                        key="C"
                                        text="C"
                                    />
                                    <core:Item
                                        key="D"
                                        text="D"
                                    />
                                </Select>
                                <Label text="URI*" />
                                <Input
                                    id="ipURI"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                                <Label text="Usuario*" />
                                <Input
                                    id="ipUsuario"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                                <Label text="Contraseña*" />
                                <Input
                                    id="ipPSW"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                                                            
                            </form:SimpleForm>
                      
                        </WizardStep>
                     
                       
                    </Wizard>
                </content>
                 <footer>
                    <OverflowToolbar>
                        <ToolbarSpacer />

                       <Button
                                                        id="nextButton"
                                                        text="Siguiente"
                                                        press="onSiguiente2"
                                                        tooltip="Siguiente paso"
                                                        type="Emphasized"
                                                    />
                                           
                        <Button
                            text="Cancelar"
                            press="onCancelCreacionSistema"
                            tooltip="Cancelar"

                        />
                    </OverflowToolbar>
                </footer>
            </Page>
        </pages>
    </NavContainer>
</mvc:View>
