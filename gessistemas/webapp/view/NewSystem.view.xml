<mvc:View
    height="100%"
    controllerName="com.becloud.pdp.gessistemas.controller.NewSystem"
    xmlns:form="sap.ui.layout.form"
    xmlns:core="sap.ui.core"
    xmlns:u="sap.ui.unified"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <NavContainer id="wizardNavContainer">
        <pages>
            <Page
                id="wizardContentPage"
                showHeader="false"
            >
                <content>
                    <Wizard
                        id="CreateProductWizard"
                        class="sapUiResponsivePadding--header sapUiResponsivePadding--content"
                        complete="wizardCompletedHandler"
                    >
                        <WizardStep
                            id="ProductTypeStep"
                            title="Información del sistema"
                            validated="true"
                        >
                            <MessageStrip
                                class="sapUiSmallMarginBottom"
                                text="Ingrese los datos del sistema"
                                showIcon="true"
                            />

                            <form:SimpleForm
                                editable="true"
                                layout="ResponsiveGridLayout"
                            >
                                <Label text="Nombre del Sistema*" />
                                <Input
                                    id="ipNameCreate"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                                <Label text="Descripción" />
                                <TextArea
                                    id="ipDescriptionCreate"
                                    rows="2"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                            </form:SimpleForm>
                                <HBox justifyContent="End"  >
                               <Button visible="false" class="sapUiSizeCompact" tooltip="Continuar"  text="Continuar"  type="Emphasized" press="onNextStep"/>
                                
                            </HBox>
             
                        </WizardStep>
                        <WizardStep
                            id="CredencialesWizard"
                            validated="false"
                            title="Credenciales"
                        >
                            <MessageStrip
                                class="sapUiSmallMarginBottom"
                                text="Ingrese las credenciales del sistema"
                                showIcon="true"
                            />
                            <form:SimpleForm
                                editable="true"
                                layout="ResponsiveGridLayout"
                            >
                                <Label text="Tipo de autenticación*" />
                                <Select
                                    id="ipTypeAuth"
                                    forceSelection="true"
                                    width="100%"
                                >
                                    <core:Item
                                        key=""
                                        text=""
                                    />
                                    <core:Item
                                        key="API"
                                        text="A"
                                    />
                                    <core:Item
                                        key="ODATA"
                                        text="B"
                                    />
                                    <core:Item
                                        key="C"
                                        text="C"
                                    />
                                    <core:Item
                                        key="D"
                                        text="D"
                                    />
                                </Select>
                                <Label text="URI*" />
                                <Input
                                    id="ipURI"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                                <Label text="Usuario*" />
                                <Input
                                    id="ipUsuario"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                                <Label text="Contraseña*" />
                                <Input
                                    id="ipPSW"
                                    width="100%"
                                    liveChange="liveChange"
                                />
                                                            
                            </form:SimpleForm>
                            <HBox justifyContent="End"  >
                               <Button  class="sapUiSizeCompact" tooltip="Crear Sistema"  text="Crear Sistema"  type="Emphasized" press="onDialogQuestion"/>
                                
                            </HBox>
                        </WizardStep>
                     
                       
                    </Wizard>
                </content>
                <footer>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            text="Cancel"
                            press="handleWizardCancel"
                        />
                    </OverflowToolbar>
                </footer>
            </Page>
            <Page
                id="wizardReviewPage"
                showHeader="false"
            >
                <content>
                    <form:SimpleForm
                        title="1. Product Type"
                        editable="false"
                        layout="ResponsiveGridLayout"
                    >
                        <form:content>
                            <Label text="Type" />
                            <Text
                                id="ProductTypeChosen"
                                text="{/productType}"
                            />
                            <Link
                                press="editStepOne"
                                text="Edit"
                            />
                        </form:content>
                    </form:SimpleForm>

                    <form:SimpleForm
                        title="2. Product Information"
                        editable="false"
                        layout="ResponsiveGridLayout"
                    >
                        <form:content>
                            <Label text="Name" />
                            <Text
                                id="ProductNameChosen"
                                text="{/productName}"
                            />
                            <Label text="Weight" />
                            <Text
                                id="ProductWeightChosen"
                                text="{/productWeight}"
                            />
                            <Label text="Manufacturer" />
                            <Text
                                id="ProductManufacturerChosen"
                                text="{/productManufacturer}"
                            />
                            <Label text="Description" />
                            <Text
                                id="ProductDescriptionChosen"
                                text="{/productDescription}"
                            />
                            <Link
                                press="editStepTwo"
                                text="Edit"
                            />
                        </form:content>
                    </form:SimpleForm>

                    <form:SimpleForm
                        title="3. Optional Information"
                        editable="false"
                        layout="ResponsiveGridLayout"
                    >
                        <form:content>
                            <Label text="Some text" />
                            <Text
                                text="Lorem ipsum dolor sit amet, consectetur adipisicing elit, sed do eiusmod
								tempor incididunt ut labore et dolore magna aliqua. "
                            />
                            <Label text="Manufacturing Date" />
                            <Text
                                id="ManufacturingDate"
                                text="{/manufacturingDate}"
                            />
                            <Label text="Availability" />
                            <Text
                                id="AvailabilityChosen"
                                text="{/availabilityType}"
                            />
                            <Label text="Size" />
                            <HBox>
                                <Text
                                    id="Size"
                                    text="{/size}"
                                />
                                <Text
                                    id="Size2"
                                    class="sapUiTinyMarginBegin"
                                    text="{/measurement}"
                                />
                            </HBox>
                            <Link
                                press="editStepThree"
                                text="Edit"
                            />
                        </form:content>
                    </form:SimpleForm>

                    <form:SimpleForm
                        title="4. Pricing"
                        editable="false"
                        layout="ResponsiveGridLayout"
                    >
                        <form:content>
                            <Label text="Price" />
                            <Text
                                id="ProductPriceChosen"
                                text="{/productPrice}"
                            />
                            <Label text="Discount Group" />
                            <Text
                                id="DiscountGroupChosen"
                                text="{/discountGroup}"
                            />
                            <Label text="VAT Included" />
                            <Text
                                id="ProductVATChosen"
                                text="{/productVAT}"
                            />
                            <Link
                                press="editStepFour"
                                text="Edit"
                            />
                        </form:content>
                    </form:SimpleForm>
                </content>
                <footer>
                    <Bar>
                        <contentRight>
                            <Button
                                text="Submit"
                                press="handleWizardSubmit"
                            />
                            <Button
                                text="Cancel"
                                press="handleWizardCancel"
                            />
                        </contentRight>
                    </Bar>
                </footer>
            </Page>
        </pages>
    </NavContainer>
</mvc:View>
