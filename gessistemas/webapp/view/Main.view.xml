<mvc:View
    controllerName="com.becloud.pdp.gessistemas.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:fb="sap.ui.comp.filterbar"
    xmlns:f="sap.f"
>
    <!-- Dynamic Page -->
    <f:DynamicPage
        id="dynamicPage"
        title="Sistemas"
        headerExpanded="{/headerExpanded}"
    >
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Sistemas" />
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>

        <!-- Dynamic Page Header -->
        <f:header>
            <f:DynamicPageHeader>
                <f:content>
                    <!-- Filter Bar Section -->
                    <fb:FilterBar
                        class="sapUiSizeCompact"
                        reset="onResetFilters"
                        showRestoreOnFB="true"
                        showGoOnFB="true"
                        showFilterConfiguration="false"
                        useToolbar="false"
                    >
                        <fb:filterItems>
                            <fb:FilterItem
                                name="A"
                                label="Sistema"
                            >
                                <fb:control>
                                    <Input
                                        id="ipSistemaSearch"
                                        width="100%"
                                        liveChange="changeFilter"
                                        placeholder="Ingrese nombre del sistema"
                                    />
                                </fb:control>
                            </fb:FilterItem>
                            <fb:FilterItem
                                name="B"
                                label="Estado"
                            >
                                <fb:control>
                                    <Select
                                        id="slEstadoSearch"
                                        selectedKey="0"
                                        change="changeFilter"
                                    >
                                        <core:Item
                                            key="0"
                                            text="Todos"
                                        />
                                        <core:Item
                                            key="1"
                                            text="Activo"
                                        />
                                        <core:Item
                                            key="2"
                                            text="Inactivo"
                                        />
                                    </Select>
                                </fb:control>
                            </fb:FilterItem>
                            <fb:FilterItem
                                name="C"
                                label="Fecha de Creación"
                            >
                                <fb:control>
                                    <DateRangeSelection
                                        id="slFechaSearch"
                                        displayFormat="dd/MM/yyyy"
                                        change="onDateRangeChange"
                                    
                                  
                            
                                        placeholder="Filtra por rango de fecha"
                                    />
                                </fb:control>
                            </fb:FilterItem>
                            

                              <fb:FilterItem
                                name="M"
                                label="Fecha de Modificación"
                            >
                                <fb:control>
                                    <DateRangeSelection
                                        id="ipFecha_modif"
                                        displayFormat="dd/MM/yyyy"
                                        change="onDateRangeChange"
                                  
                            
                                        placeholder="Filtra por rango de fecha"
                                    />
                                </fb:control>
                            </fb:FilterItem>
                        </fb:filterItems>
                    </fb:FilterBar>
                </f:content>
            </f:DynamicPageHeader>
        </f:header>

        <!-- Dynamic Page Content -->
        <f:content>
            <!-- Users Table Section -->
            <VBox class="sapUiSmallMargin">
                <Table
                    id="idProductsTable"
                    sticky="ColumnHeaders,HeaderToolbar"
                    items="{path: 'oModelCompanySystem>/', sorter: [{path: 'id', descending: false}]}"
                    mode="None"
                    updateFinished="updateFinished"
                    growing="true"
                    growingThreshold="10"
                >
                    <headerToolbar>
                        <Toolbar>
                            <content>
                                <Title
                                    id="tProducts"
                                    text="Registros (0)"
                                />
                                <Button
                                    icon="sap-icon://excel-attachment"
                                    press="onExcel"
                                    tooltip="Descargar registros"
                                />
                                <ToolbarSpacer />
                                <Button
                                    class="sapUiSizeCompact"
                                    tooltip="Ingresar Sistema"
                                    iconFirst="false"
                                    text="Ingresar Sistema"
                                    icon="sap-icon://create-form"
                                    type="Emphasized"
                                    press="onNewSystem"
                                />
                                <Button
                                    class="sapUiSizeCompact"
                                    tooltip="Actualizar datos"
                                    iconFirst="false"
                                    
                                    icon="sap-icon://synchronize"
                                    type="Emphasized"
                                    press="onRefresh"
                                />
                            </content>
                        </Toolbar>
                    </headerToolbar>
                    <columns>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="ID" />
                        </Column>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Sistema" />
                        </Column>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Fecha de Creación" />
                        </Column>
                         <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Fecha de Modificación" />
                        </Column>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                        >
                            <Text text="Estado" />
                        </Column>
                        <Column
                            minScreenWidth="Tablet"
                            demandPopin="true"
                            hAlign="Center"
                            vAlign="Middle"
                        >
                            <Text text="Acciones" />
                        </Column>
                    </columns>
                    <items>
                        <ColumnListItem
                            type="Detail"
                            detailPress="onEdit"
                            vAlign="Middle"
                            
                        
                        >
                            <cells>
                                <ObjectIdentifier
                                    text="{oModelCompanySystem>id}"
                                />
                                <ObjectIdentifier
                                    text="{oModelCompanySystem>companySystemName}"
                                />
                                <ObjectIdentifier
                                    text="{path: 'oModelCompanySystem>creationDate', formatter:'.formatDate'}"
                                />
                                <ObjectIdentifier
                                    text="{path: 'oModelCompanySystem>Fecha_modificacion', formatter:'.formatDate'}"
                                />
                                <ObjectStatus
                                    text="{path: 'oModelCompanySystem>status', formatter: '.formatterEstado'}"
                                    state="{path: 'oModelCompanySystem>status', formatter: '.formatterState'}"
                                    inverted="true"
                                />
                                <HBox justifyContent="SpaceAround">
                                    <Button
                                        icon="sap-icon://detail-view"
                                        press="onShowInformation"
                                        tooltip="Ver Detalles"
                                        type="Transparent"
                                    />
                                    <Button
                                        icon="sap-icon://connected"
                                        press=".onListUserData"
                                        tooltip="Conexiones"
                                        type="Transparent"
                                    />
                                    <Button
                                        icon="sap-icon://role"
                                        press="onCredenciales"
                                        tooltip="Credenciales"
                                        type="Transparent"
                                    />
                                </HBox>
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
